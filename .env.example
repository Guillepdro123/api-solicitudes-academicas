# Copia este archivo como .env y completa los valores (el .env no se sube a GitHub)

# Puerto para la aplicación FastAPI
PORT=8000

# "cola" (versión mejorada) o "directo" (versión base para comparar en la prueba de carga)
MODO_GUARDADO=cola

# Zona horaria para la fecha de las solicitudes
ZONA_HORARIA=America/Bogota

# Credenciales para el bot de Telegram
TELEGRAM_BOT_TOKEN=
# ID del chat o del administrador donde se enviarán las notificaciones
TELEGRAM_CHAT_ID=
# Segundos de pausa entre mensajes en modo cola
TELEGRAM_INTERVALO=1

# Credenciales de Google Drive API (usa una de las dos opciones)
# Opción 1, en local: ruta al JSON de la cuenta de servicio
GOOGLE_APPLICATION_CREDENTIALS=credenciales.json
# Opción 2, al desplegar: el contenido completo del JSON en una sola línea
GOOGLE_CREDENTIALS_JSON=
# ID del archivo .xlsx en Google Drive (compartido con el correo de la cuenta de servicio)
GOOGLE_DRIVE_FILE_ID=
